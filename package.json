{
  "name": "driftless",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted living docs server for teams on Cloudflare",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run build:worker && npm run build:dashboard",
    "build:worker": "tsc -p tsconfig.worker.json --noEmit && wrangler deploy --dry-run --outdir=dist/worker",
    "build:dashboard": "npm run build --workspace=dashboard",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && npm run typecheck --workspace=dashboard",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "dev:dashboard": "npm run dev --workspace=dashboard",
    "db:migrate:local": "wrangler d1 migrations apply driftless --local"
  },
  "workspaces": [
    "dashboard"
  ],
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wrangler": "^3.84.0"
  },
  "dependencies": {
    "hono": "^4.6.8",
    "zod": "^3.23.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.17.19": true,
    "workerd@1.20250718.0": true,
    "sharp@0.33.5": true
  }
}
